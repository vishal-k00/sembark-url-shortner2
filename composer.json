{
  "name": "sembark/url-shortener",
  "type": "project",
  "description": "Multi-tenant URL shortener built with Laravel 12",
  "keywords": ["laravel", "url-shortener", "multi-tenant"],
  "license": "proprietary",
  "require": {"php": "^8.2", "laravel/framework": "^12.0", "laravel/tinker": "^2.10"},
  "require-dev": {"fakerphp/faker": "^1.23", "phpunit/phpunit": "^11.5", "mockery/mockery": "^1.6"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "test": "@php artisan test"},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": {"php-http/discovery": true}},
  "minimum-stability": "stable", "prefer-stable": true
}
